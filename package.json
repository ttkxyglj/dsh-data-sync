{
  "name": "@local/dsh-data-sync",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Move a DeepSeek Harness installation between machines: snapshot the profile configuration, the long-term memory store and the skills into a private git repository, restore them with absolute-path remapping, and keep a local backup rotation plus a scheduled automatic backup.",
  "license": "MIT",
  "author": "Erji Gao",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "migration",
    "backup",
    "config-sync",
    "memory"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
